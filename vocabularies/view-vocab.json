{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/vocabularies/view-vocab.json",
  "x-stableId": "https://unpkg.com/@burgan-tech/vnext-schema/vocabularies/view-vocab.json",
  "title": "vNext View Vocabulary",
  "description": "Vocabulary for vNext platform-owned view and schema extensions. Provides reusable definitions for x-* fields consumed by backend, JSON Schema validators, and UI renderers.",
  "definitions": {
    "localizedText": {
      "type": "object",
      "description": "Language-code keyed localized text map.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    },
    "x-labels": {
      "$ref": "#/definitions/localizedText"
    },
    "x-errorMessages": {
      "type": "object",
      "description": "Localized messages keyed by JSON Schema validation keyword.",
      "properties": {
        "required": {
          "$ref": "#/definitions/localizedText"
        },
        "minLength": {
          "$ref": "#/definitions/localizedText"
        },
        "maxLength": {
          "$ref": "#/definitions/localizedText"
        },
        "minimum": {
          "$ref": "#/definitions/localizedText"
        },
        "maximum": {
          "$ref": "#/definitions/localizedText"
        },
        "pattern": {
          "$ref": "#/definitions/localizedText"
        },
        "format": {
          "$ref": "#/definitions/localizedText"
        },
        "enum": {
          "$ref": "#/definitions/localizedText"
        },
        "const": {
          "$ref": "#/definitions/localizedText"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "x-enum": {
      "type": "object",
      "description": "Localized display labels keyed by enum value.",
      "additionalProperties": {
        "$ref": "#/definitions/localizedText"
      },
      "minProperties": 1
    },
    "roleGrantCondition": {
      "type": "object",
      "description": "One role in an allOf/anyOf list: only a role name, a predefined instance role or a dynamic expression. No grant and no nesting (depth 1).",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "Role name (e.g. morph-idm.initiator) or dynamic expression (e.g. $userBehalfOf.$.context.Instance.Data.initial.customer.ownerUserId)."
        }
      },
      "additionalProperties": false
    },
    "roleGrant": {
      "type": "object",
      "description": "A single role grant: a role name, predefined instance role ($InstanceStarter, …) or dynamic expression ($user./$userBehalfOf./$role. + $.context.<path>), with allow or deny. Exactly one of role, allOf (all listed roles required) or anyOf (at least one listed role) selects who the grant applies to.",
      "required": [
        "grant"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "Role name (e.g. morph-idm.initiator) or dynamic expression (e.g. $userBehalfOf.$.context.Instance.Data.initial.customer.ownerUserId)."
        },
        "grant": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ],
          "description": "DENY always overrides ALLOW"
        },
        "allOf": {
          "type": "array",
          "minItems": 1,
          "description": "Conjunction: the caller must hold every listed role.",
          "items": {
            "$ref": "#/definitions/roleGrantCondition"
          }
        },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "description": "Disjunction: the caller must hold at least one listed role.",
          "items": {
            "$ref": "#/definitions/roleGrantCondition"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "role"
          ]
        },
        {
          "required": [
            "allOf"
          ]
        },
        {
          "required": [
            "anyOf"
          ]
        }
      ],
      "additionalProperties": false
    },
    "x-roles": {
      "type": "array",
      "description": "Role-based visibility/permission grants for a view or field. Roles may be domain-qualified names or dynamic expressions. DENY overrides ALLOW.",
      "items": {
        "$ref": "#/definitions/roleGrant"
      },
      "minItems": 1
    },
    "x-filterOperators": {
      "type": "array",
      "description": "Allowed filter operators for this field. Empty or absent means the field is not filterable. Operator semantics depend on the field's JSON type (number/integer: numeric compare; string + gt/lt/ge/le/between: date compare; string + eq/like/startswith/endswith: text compare; boolean: equality; array: includes).",
      "items": {
        "type": "string",
        "enum": [
          "eq",
          "ne",
          "gt",
          "ge",
          "lt",
          "le",
          "between",
          "match",
          "like",
          "startswith",
          "endswith",
          "in",
          "nin"
        ]
      },
      "uniqueItems": true
    },
    "x-sortable": {
      "type": "boolean",
      "description": "When true, the field is sortable. Absent means not sortable."
    },
    "x-displayFormat": {
      "type": "string",
      "minLength": 1,
      "description": "UI-facing format hint (e.g. yyyy-MM-dd'T'HH:mm:ssXXX)."
    },
    "filterExpression": {
      "type": "object",
      "description": "Dynamic request filter parameter resolved from form, instance, or component parameters.",
      "required": [
        "param",
        "value"
      ],
      "properties": {
        "param": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "x-lov": {
      "type": "object",
      "description": "List-of-values data source definition for dropdown and selection components.",
      "required": [
        "source",
        "valueField",
        "displayField"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "URN of the data source function."
        },
        "valueField": {
          "type": "string",
          "minLength": 1,
          "description": "JSONPath expression for the option value."
        },
        "displayField": {
          "type": "string",
          "minLength": 1,
          "description": "JSONPath expression for the option display label."
        },
        "filter": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/filterExpression"
          }
        }
      },
      "additionalProperties": false
    },
    "x-lookup": {
      "type": "object",
      "description": "Single-record enrichment source definition.",
      "required": [
        "source",
        "resultField"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "URN of the data source function."
        },
        "resultField": {
          "type": "string",
          "minLength": 1,
          "description": "JSONPath expression for the returned object."
        },
        "filter": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/filterExpression"
          }
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "description": "Conditional visibility or enablement expression.",
      "anyOf": [
        {
          "required": [
            "field",
            "operator"
          ]
        },
        {
          "required": [
            "allOf"
          ]
        },
        {
          "required": [
            "anyOf"
          ]
        },
        {
          "required": [
            "not"
          ]
        }
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": [
            "equals",
            "notEquals",
            "in",
            "notIn",
            "isEmpty",
            "isNotEmpty",
            "contains",
            "greaterThan",
            "lessThan"
          ]
        },
        "value": {},
        "allOf": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          },
          "minItems": 1
        },
        "anyOf": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          },
          "minItems": 1
        },
        "not": {
          "$ref": "#/definitions/condition"
        }
      },
      "additionalProperties": false
    },
    "x-conditional": {
      "type": "object",
      "description": "Conditional visibility and enablement rules for a schema property.",
      "properties": {
        "showIf": {
          "$ref": "#/definitions/condition"
        },
        "hideIf": {
          "$ref": "#/definitions/condition"
        },
        "enableIf": {
          "$ref": "#/definitions/condition"
        },
        "disableIf": {
          "$ref": "#/definitions/condition"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "x-binding": {
      "type": "string",
      "description": "Nested component binding requirement.",
      "enum": [
        "required",
        "optional"
      ]
    },
    "x-encryption": {
      "type": "object",
      "description": "Encryption and data-classification metadata for a field. 'hash' is applied when the data is written: the stored (and served) value is HASHED:SHA256:<hex> (or SHA512), an HMAC under a salt the runtime generates for each instance — irreversible, so it takes no roles. 'encrypt' stores the value as an AES-256-GCM token (ENCRYPTED:AES256:i1:<base64url>) in the instance data and decrypts it on load, so the engine works on plaintext; on the read surfaces a caller in the exemption list sees the plaintext and every other caller the stored token. The key is generated by the runtime for each instance and kept in the flow schema's InstanceSecrets table, never in the schema. Only instance data is encrypted: transition bodies, task journals, events and caches are not (yet). 'none' declares no encryption. 'persisted' and 'transport' were removed (never enforced; use 'encrypt'). An active type (other than 'none') cannot be combined with x-masking, x-filterOperators, x-sortable or x-indexed on the same property, and only applies to string properties reachable through nested 'properties'.",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "hash",
            "encrypt"
          ]
        },
        "params": {
          "type": "object",
          "description": "Parameters of type 'hash'. No salt or key may appear here.",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256",
                "sha512"
              ],
              "default": "sha256"
            }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "description": "Allow-only EXEMPTION list: a caller matching an allow grant sees the raw value; every other caller (unlisted, misspelled or missing roles) sees it transformed. deny is not accepted. Not accepted for type 'hash' (hashed on write, irreversible).",
          "items": {
            "allOf": [
              {
                "$ref": "#/definitions/roleGrant"
              },
              {
                "properties": {
                  "grant": {
                    "const": "allow"
                  }
                },
                "required": [
                  "role"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "allOf"
                      ]
                    },
                    {
                      "required": [
                        "anyOf"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "description": "Data classification of the field (e.g. PII, PII-Identification, Financial, Credential). Metadata for tooling and governance; not enforced by the runtime."
        },
        "redactInLogs": {
          "type": "boolean",
          "description": "Declares that the value must never appear in logs. The runtime's own structured logs never carry instance data; this flag is for tooling and log pipelines and is not enforced by the runtime."
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "description": "Retention period of the field in days. Metadata for governance; not enforced by the runtime."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "hash"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "params"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hash"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "roles"
              ]
            }
          }
        }
      ]
    },
    "x-masking": {
      "type": "object",
      "description": "Master-schema field masking applied by the runtime on the caller-facing read surfaces (data function, instance GET/list, sync start/transition responses), after x-roles pruning. Stored data never changes. Only on type: string properties reachable through nested properties; cannot be combined with x-filterOperators, x-sortable or an active x-encryption.",
      "required": [
        "operator"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "enum": [
            "mask",
            "replace"
          ],
          "description": "mask keeps keepFirst/keepLast characters and masks the middle (length-preserving); replace writes params.value."
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maskingChar": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1,
              "default": "*"
            },
            "keepFirst": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "keepLast": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "description": "Allow-only EXEMPTION list: a caller matching an allow grant sees the raw value; every other caller (unlisted, misspelled or missing roles) sees it masked. deny is not accepted.",
          "items": {
            "allOf": [
              {
                "$ref": "#/definitions/roleGrant"
              },
              {
                "properties": {
                  "grant": {
                    "const": "allow"
                  }
                },
                "required": [
                  "role"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "allOf"
                      ]
                    },
                    {
                      "required": [
                        "anyOf"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "const": "replace"
              }
            }
          },
          "then": {
            "required": [
              "operator",
              "params"
            ],
            "properties": {
              "params": {
                "required": [
                  "value"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "maskingChar"
                      ]
                    },
                    {
                      "required": [
                        "keepFirst"
                      ]
                    },
                    {
                      "required": [
                        "keepLast"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "const": "mask"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "not": {
                  "required": [
                    "value"
                  ]
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "x-validation": {
      "type": "object",
      "description": "Backend-defined custom validation rule metadata.",
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "errorMessages": {
          "$ref": "#/definitions/localizedText"
        }
      },
      "additionalProperties": false
    },
    "viewDocument": {
      "type": "object",
      "description": "Lightweight vNext view document root contract.",
      "required": [
        "$schema",
        "dataSchema",
        "view"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://amorphie.io/meta/view-vocabulary/1.0"
        },
        "dataSchema": {
          "type": "string",
          "minLength": 1
        },
        "lookups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "uiState": {
          "type": "object"
        },
        "view": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}

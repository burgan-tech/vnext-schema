{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/vocabularies/record-vocab.json",
  "x-stableId": "https://unpkg.com/@burgan-tech/vnext-schema/vocabularies/record-vocab.json",
  "title": "vNext Record Vocabulary",
  "description": "The vocabulary of a schema in the RECORD role — a flow's master schema: the shape the runtime validates every write against, filters and sorts on, and exposes through x-roles / x-masking / x-encryption. Extends data-base-vocab.json and accepts view-hints-vocab.json. An input keyword (x-context-source, x-encrypt) means nothing here.",
  "definitions": {
    "x-computed": {
      "type": "object",
      "description": "A DERIVED field. 'server': the runtime computes it and it arrives as a plain field (the only mode a list can sort or filter on; needs runtime support). 'client': a client evaluates it from this declaration. The first case whose 'when' matches wins; otherwise 'fallback'; an unresolvable result becomes '' or null per 'whenAbsent'. A computed property is never 'required' and should be 'readOnly'.",
      "properties": {
        "evaluatedBy": {
          "enum": [
            "server",
            "client"
          ]
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "$ref": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/vocabularies/view-vocab.json#/definitions/condition"
              },
              "join": {
                "type": "object",
                "required": [
                  "fields"
                ],
                "properties": {
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "separator": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "arithmetic": {
                "type": "object",
                "required": [
                  "op",
                  "fields"
                ],
                "properties": {
                  "op": {
                    "enum": [
                      "add",
                      "subtract",
                      "multiply",
                      "divide"
                    ]
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 2
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "fallback": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "join": {
              "type": "object",
              "required": [
                "fields"
              ],
              "properties": {
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "separator": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "arithmetic": {
              "type": "object",
              "required": [
                "op",
                "fields"
              ],
              "properties": {
                "op": {
                  "enum": [
                    "add",
                    "subtract",
                    "multiply",
                    "divide"
                  ]
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 2
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "whenAbsent": {
          "enum": [
            "empty",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "x-persistance": {
      "type": "string",
      "enum": [
        "persisted",
        "transient"
      ],
      "description": "PROPOSED (vnext-schema#153). 'transient': the field is accepted at intake and NOT persisted — it never reaches instance data or transition history (an OTP, a password). Absent = 'persisted'. Requires runtime support; until then it is a declaration only."
    },
    "property": {
      "description": "A schema object (the root, or any property / item below it) written in this ROLE: it may carry the base keywords, the view hints and this role's own keywords, and no other x-* keyword. Applied recursively to properties, items, combinators and definitions.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "allOf": [
            {
              "$ref": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/vocabularies/data-base-vocab.json#/definitions/keywords"
            },
            {
              "$ref": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/vocabularies/view-hints-vocab.json#/definitions/keywords"
            },
            {
              "properties": {
                "x-roles": {
                  "$ref": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/vocabularies/view-vocab.json#/definitions/x-roles"
                },
                "x-masking": {
                  "$ref": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/vocabularies/view-vocab.json#/definitions/x-masking"
                },
                "x-encryption": {
                  "$ref": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/vocabularies/view-vocab.json#/definitions/x-encryption"
                },
                "x-storage": {
                  "$ref": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/vocabularies/view-vocab.json#/definitions/x-storage"
                },
                "x-filterOperators": {
                  "$ref": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/vocabularies/view-vocab.json#/definitions/x-filterOperators"
                },
                "x-sortable": {
                  "$ref": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/vocabularies/view-vocab.json#/definitions/x-sortable"
                },
                "x-indexed": {
                  "type": "boolean",
                  "description": "Shape only; its placement rules live in schema-definition.schema.json (masterIndexSchema)."
                },
                "x-context-target": {
                  "$ref": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/vocabularies/data-vocab.json#/definitions/x-context-target"
                },
                "x-computed": {
                  "$ref": "#/definitions/x-computed"
                },
                "x-persistance": {
                  "$ref": "#/definitions/x-persistance"
                }
              }
            }
          ],
          "propertyNames": {
            "if": {
              "pattern": "^x-"
            },
            "then": {
              "enum": [
                "x-binding",
                "x-computed",
                "x-conditional",
                "x-context-target",
                "x-displayFormat",
                "x-encryption",
                "x-enum",
                "x-errorMessages",
                "x-filterOperators",
                "x-group",
                "x-helpText",
                "x-indexed",
                "x-labels",
                "x-lookup",
                "x-lov",
                "x-masking",
                "x-order",
                "x-persistance",
                "x-placeholder",
                "x-roles",
                "x-sortable",
                "x-storage",
                "x-uiHint",
                "x-uiNote",
                "x-validation"
              ]
            }
          },
          "properties": {
            "properties": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/definitions/property"
                  }
                ]
              }
            },
            "patternProperties": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/definitions/property"
                  }
                ]
              }
            },
            "definitions": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/definitions/property"
                  }
                ]
              }
            },
            "$defs": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/definitions/property"
                  }
                ]
              }
            },
            "dependentSchemas": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/definitions/property"
                  }
                ]
              }
            },
            "items": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "$ref": "#/definitions/property"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "$ref": "#/definitions/property"
                      }
                    ]
                  }
                }
              ]
            },
            "prefixItems": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/definitions/property"
                  }
                ]
              }
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/definitions/property"
                }
              ]
            },
            "allOf": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/definitions/property"
                  }
                ]
              }
            },
            "anyOf": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/definitions/property"
                  }
                ]
              }
            },
            "oneOf": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/definitions/property"
                  }
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/definitions/property"
                }
              ]
            },
            "if": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/definitions/property"
                }
              ]
            },
            "then": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/definitions/property"
                }
              ]
            },
            "else": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/definitions/property"
                }
              ]
            }
          }
        }
      ]
    },
    "schema": {
      "description": "The root of a schema written in this role.",
      "$ref": "#/definitions/property"
    },
    "allowedKeywords": {
      "description": "Every x-* keyword this role accepts (base + view hints + its own), as data — for tools that want to report rather than refuse.",
      "const": [
        "x-binding",
        "x-computed",
        "x-conditional",
        "x-context-target",
        "x-displayFormat",
        "x-encryption",
        "x-enum",
        "x-errorMessages",
        "x-filterOperators",
        "x-group",
        "x-helpText",
        "x-indexed",
        "x-labels",
        "x-lookup",
        "x-lov",
        "x-masking",
        "x-order",
        "x-persistance",
        "x-placeholder",
        "x-roles",
        "x-sortable",
        "x-storage",
        "x-uiHint",
        "x-uiNote",
        "x-validation"
      ]
    }
  }
}

{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://unpkg.com/@burgan-tech/vnext-schema@__SCHEMA_VERSION__/schemas/extension-definition.schema.json",
    "title": "vNext Extension Definition",
    "description": "Schema for vNext Extension Component Definition JSON files (sys-extensions flow)",
    "type": "object",
    "required": [
        "key",
        "version",
        "domain",
        "flow",
        "flowVersion",
        "tags",
        "attributes"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "JSON Schema reference",
            "format": "uri"
        },
        "key": {
            "type": "string",
            "description": "Extension key identifier",
            "pattern": "^[a-z0-9-]+$"
        },
        "version": {
            "type": "string",
            "description": "Version in Major.Minor.Patch format",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z]+\\.\\d+)?$"
        },
        "domain": {
            "type": "string",
            "description": "Domain identifier",
            "pattern": "^[a-z0-9-]+$"
        },
        "flow": {
            "type": "string",
            "description": "Flow identifier for extensions",
            "const": "sys-extensions"
        },
        "flowVersion": {
            "type": "string",
            "description": "Flow version",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z]+\\.\\d+)?$"
        },
        "tags": {
            "type": "array",
            "description": "Extension tags",
            "items": {
                "type": "string"
            },
            "minItems": 1
        },
        "_comment": {
            "type": "string",
            "description": "Comment about the extension"
        },
        "attributes": {
            "type": "object",
            "description": "Extension definition attributes",
            "required": [
                "type",
                "scope",
                "task"
            ],
            "properties": {
                "type": {
                    "type": "integer",
                    "description": "Extension type (ExtensionType enum value)",
                    "oneOf": [
                        {
                            "const": 1,
                            "description": "Global - Extension that will work while recording samples are rotating in all streams"
                        },
                        {
                            "const": 2,
                            "description": "GlobalAndRequested - Extension that will work on all streams and when requesting recording samples"
                        },
                        {
                            "const": 3,
                            "description": "DefinedFlows - Extension that will only work on the streams for which it is defined"
                        },
                        {
                            "const": 4,
                            "description": "DefinedFlowAndRequested - An extension that will only work on the streams it is defined for and when requested"
                        }
                    ]
                },
                "scope": {
                    "type": "integer",
                    "description": "Extension scope (ExtensionScope enum value)",
                    "oneOf": [
                        {
                            "const": 1,
                            "description": "GetInstance - The extension works on {domain}/workflows/{workflow}/instances/{instance} endpoint"
                        },
                        {
                            "const": 2,
                            "description": "GetAllInstances - The extension works on {domain}/workflows/{workflow}/instances endpoint"
                        },
                        {
                            "const": 3,
                            "description": "Everywhere - The extension works on all get endpoints"
                        }
                    ]
                },
                "task": {
                    "type": "object",
                    "description": "Extension execution task",
                        "anyOf": [
                            {
                                "required": [
                                    "mapping"
                                ]
                            },
                            {
                                "required": [
                                    "input"
                                ]
                            },
                            {
                                "required": [
                                    "output"
                                ]
                            }
                        ],
                        "not": {
                            "required": [
                                "mapping"
                            ],
                            "anyOf": [
                                {
                                    "required": [
                                        "input"
                                    ]
                                },
                                {
                                    "required": [
                                        "output"
                                    ]
                                }
                            ]
                        },
                    "properties": {
                            "input": {
                                "$ref": "#/definitions/inputMappingBlock"
                            },
                            "output": {
                                "$ref": "#/definitions/outputMappingBlock"
                            },

                        "order": {
                            "type": "integer",
                            "description": "Task execution order",
                            "minimum": 1
                        },
                        "task": {
                            "description": "Task reference - can be either explicit reference or $ref",
                            "oneOf": [
                                {
                                    "type": "object",
                                    "description": "Explicit task reference",
                                    "required": [
                                        "key",
                                        "domain",
                                        "flow",
                                        "version"
                                    ],
                                    "properties": {
                                        "key": {
                                            "type": "string",
                                            "description": "Task key"
                                        },
                                        "domain": {
                                            "type": "string",
                                            "description": "Task domain"
                                        },
                                        "flow": {
                                            "type": "string",
                                            "description": "Task workflow",
                                            "const": "sys-tasks"
                                        },
                                        "version": {
                                            "type": "string",
                                            "description": "Task version"
                                        }
                                    },
                                    "additionalProperties": false
                                },
                                {
                                    "type": "object",
                                    "description": "Task reference using ref",
                                    "required": [
                                        "ref"
                                    ],
                                    "properties": {
                                        "ref": {
                                            "type": "string",
                                            "description": "Reference to task file"
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            ]
                        },
                        "mapping": {
                            "type": "object",
                            "description": "Extension mapping code",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": ["G", "L"],
                                    "enumDescriptions": [
                                        "Global",
                                        "Local"
                                    ],
                                    "default": "L",
                                    "description": "Mapping type - Global or Local"
                                },
                                "location": {
                                    "type": "string",
                                    "description": "Code file location",
                                    "pattern": "^\\./.*\\.csx$"
                                },
                                "code": {
                                    "description": "Mapping code content (string), or a sys-mappings reference when encoding is REF.",
                                    "oneOf": [
                                        {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        {
                                            "$ref": "#/definitions/mappingRef"
                                        }
                                    ]
                                },
                                "encoding": {
                                    "type": "string",
                                    "description": "Code encoding format",
                                    "enum": ["B64", "NAT", "REF"],
                                    "default": "B64"
                                },
                                "scripts": {
                                    "$ref": "#/definitions/scripts"
                                }
                            },
                            "additionalProperties": false,
                            "allOf": [
                                {
                                    "if": {
                                        "properties": {
                                            "type": {
                                                "const": "G"
                                            }
                                        },
                                        "required": ["type"]
                                    },
                                    "then": {
                                        "required": []
                                    },
                                    "else": {
                                        "required": ["code"]
                                    }
                                },
                                {
                                    "if": {
                                        "properties": {
                                            "encoding": {
                                                "const": "REF"
                                            }
                                        },
                                        "required": ["encoding"]
                                    },
                                    "then": {
                                        "required": ["code"],
                                        "properties": {
                                            "code": {
                                                "$ref": "#/definitions/mappingRef"
                                            }
                                        }
                                    },
                                    "else": {
                                        "properties": {
                                            "code": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                "labels": {
                    "type": "array",
                    "description": "Multi-language labels for extension",
                    "items": {
                        "type": "object",
                        "required": [
                            "label",
                            "language"
                        ],
                        "properties": {
                            "label": {
                                "type": "string",
                                "minLength": 1
                            },
                            "language": {
                                "type": "string",
                                "pattern": "^[a-z]{2}-[A-Z]{2}$",
                                "examples": [
                                    "en-US",
                                    "tr-TR",
                                    "de-DE"
                                ]
                            }
                        }
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "definitions": {
            "mappingReadPath": {
                "type": "string",
                "pattern": "^\\$(?:\\.[^.\\[\\]'\"\\s]+|\\['(?:[^'\\\\]|\\\\['\\\\])*'\\]|\\[(?:[0-9]+|\\*)\\])*$",
                "maxLength": 1000,
                "description": "JSON path read by a declarative mapping: $, .name, ['name'], [n], [*]. No filters, no recursive descent."
            },
            "mappingWritePath": {
                "type": "string",
                "pattern": "^\\$(?:\\.[^.\\[\\]'\"\\s]+|\\['(?:[^'\\\\]|\\\\['\\\\])*'\\])+$",
                "maxLength": 1000,
                "description": "Instance-data write target of a declarative output mapping: $ followed by at least one .name or ['name'] segment. No index, no wildcard, not the root."
            },
            "mappingInputWritePath": {
                "type": "string",
                "pattern": "^\\$(?:\\.(?:body|headers|query)|\\['(?:body|headers|query)'\\])(?:\\.[^.\\[\\]'\"\\s]+|\\['(?:[^'\\\\]|\\\\['\\\\])*'\\])*$",
                "maxLength": 1000,
                "description": "Request-surface write target of a declarative input mapping: $.body, $.headers or $.query, then .name / ['name'] segments. $.route is not supported."
            },
            "mappingExpression": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000,
                "description": "Dynamic Expresso expression producing the value to write. Variables: data, input, instance (camelCase members), now, user (available, roles, hasRole), context (legacy), result (output only). Assignment is disabled."
            },
            "inputMappingBlock": {
                "type": "object",
                "description": "Declarative input mapping: shapes the task request. select + into copy one value (both or neither); set writes expressions in declaration order. Targets are request surfaces the task type supports.",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                    "select": {
                        "$ref": "#/definitions/mappingReadPath",
                        "description": "Path read from the scope; starts with a variable name, for example $.data.customer."
                    },
                    "into": {
                        "$ref": "#/definitions/mappingInputWritePath"
                    },
                    "set": {
                        "type": "object",
                        "minProperties": 1,
                        "propertyNames": {
                            "$ref": "#/definitions/mappingInputWritePath"
                        },
                        "additionalProperties": {
                            "$ref": "#/definitions/mappingExpression"
                        },
                        "description": "Request-surface path -> expression, applied after into in declaration order."
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "required": [
                                "select"
                            ]
                        },
                        "then": {
                            "required": [
                                "into"
                            ]
                        }
                    },
                    {
                        "if": {
                            "required": [
                                "into"
                            ]
                        },
                        "then": {
                            "required": [
                                "select"
                            ]
                        }
                    }
                ]
            },
            "outputMappingBlock": {
                "type": "object",
                "description": "Declarative output mapping: writes the task result into instance data as one append. select reads result (default $.body); into writes the selected value (without into it merges at the data root); set writes expressions after into, in declaration order.",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                    "select": {
                        "$ref": "#/definitions/mappingReadPath",
                        "description": "Path read from result ({ body, headers, statusCode }); root $ is result."
                    },
                    "into": {
                        "$ref": "#/definitions/mappingWritePath"
                    },
                    "set": {
                        "type": "object",
                        "minProperties": 1,
                        "propertyNames": {
                            "$ref": "#/definitions/mappingWritePath"
                        },
                        "additionalProperties": {
                            "$ref": "#/definitions/mappingExpression"
                        },
                        "description": "Instance-data path -> expression, applied after into in declaration order (a later entry wins)."
                    }
                }
            },
        "mappingRef": {
            "type": "object",
            "description": "Reference to a sys-mappings component.",
            "required": [
                "key",
                "version",
                "domain",
                "flow"
            ],
            "properties": {
                "key": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                },
                "domain": {
                    "type": "string"
                },
                "flow": {
                    "type": "string",
                    "const": "sys-mappings"
                }
            },
            "additionalProperties": false
        },
        "scripts": {
            "type": "object",
            "description": "Helper script references and allowed assemblies for mapping execution.",
            "properties": {
                "helpers": {
                    "type": "array",
                    "description": "References to sys-mappings helper components.",
                    "items": {
                        "$ref": "#/definitions/mappingRef"
                    }
                },
                "allowedAssemblies": {
                    "type": "array",
                    "description": "Allowed .NET assemblies for the script execution context.",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        }
    }
}